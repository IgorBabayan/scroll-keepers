<Application x:Class="ScrollKeeper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Active color palette. Must stay first: IThemeService swaps it when Windows switches light/dark. -->
                <ResourceDictionary Source="Themes/Colors/ClaudeDark.xaml" />
                <ResourceDictionary Source="Themes/WindowChrome.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Presentation/Views/Addons/AddonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
