<Window x:Class="ScrollKeeper.Presentation.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:settingsVm="clr-namespace:ScrollKeeper.Presentation.ViewModels.Settings"
        xmlns:behaviors="clr-namespace:ScrollKeeper.Presentation.Behaviors"
        xmlns:toastViews="clr-namespace:ScrollKeeper.Presentation.Views.Toasts"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=settingsVm:SettingsViewModel, IsDesignTimeCreatable=False}"
        Title="Settings"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource BodyFont}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}">
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CloseCaptionButtonStyle}"
                        ToolTip="Close"
                        Content="&#xE8BB;"
                        Command="{Binding CancelCommand}" />
            </Grid>

            <!-- ===== Content ===== -->
            <StackPanel Grid.Row="1" Margin="20,16,20,20">

                <!-- AddOns folder -->
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="AddOns folder" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,2,0,8"
                           Text="The Elder Scrolls Online AddOns folder, usually Documents\Elder Scrolls Online\live\AddOns (liveeu for the EU server)." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding AddonsFolderPath, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="AddOns folder" />
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Select folder"
                            AutomationProperties.Name="Select AddOns folder"
                            Command="{Binding SelectFolderCommand}">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="15" Text="&#xED25;" />
                    </Button>
                </Grid>

                <DockPanel Margin="0,6,0,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningForegroundBrush}"
                               Text="This folder does not exist."
                               Visibility="{Binding IsAddonsFolderMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningForegroundBrush}"
                               Text="This does not look like an AddOns folder."
                               Visibility="{Binding LooksLikeWrongFolder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button DockPanel.Dock="Right"
                            Margin="0,0,-8,0"
                            Style="{StaticResource TextLinkButtonStyle}"
                            Content="Use default folder"
                            Command="{Binding ResetFolderCommand}" />
                </DockPanel>

                <!-- Updates -->
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Margin="0,16,0,0" Text="Updates" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,2,0,8"
                           Text="{Binding CurrentVersionText}" />

                <DockPanel LastChildFill="False">
                    <CheckBox DockPanel.Dock="Left"
                              VerticalAlignment="Center"
                              Content="_Auto-update"
                              IsChecked="{Binding AutoUpdate}"
                              AutomationProperties.Name="Auto-update" />
                    <Button DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="_Download and update"
                            ToolTip="Download the new version, then restart ScrollKeeper to install it"
                            Command="{Binding DownloadAndUpdateCommand}" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource DialogButtonStyle}"
                            Content="Check for _updates"
                            Command="{Binding CheckForUpdatesCommand}" />
                </DockPanel>
                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                           Margin="26,4,0,0"
                           Text="On every start, check GitHub for a newer release. If one is found, it is downloaded and installed, and ScrollKeeper restarts automatically." />
                <TextBlock Margin="26,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding AvailableUpdateText}"
                           Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Countdown before ScrollKeeper closes to install an update -->
                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Text="Seconds before auto-restart"
                               Foreground="{DynamicResource WindowForegroundBrush}" />
                    <Button Margin="12,0,0,0"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Decrease"
                            AutomationProperties.Name="Decrease seconds before auto-restart"
                            Command="{Binding DecreaseRestartDelayCommand}">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE738;" />
                    </Button>
                    <TextBox Width="64"
                             Margin="4,0"
                             HorizontalContentAlignment="Center"
                             MaxLength="3"
                             Text="{Binding RestartDelayText, UpdateSourceTrigger=PropertyChanged}"
                             behaviors:NumericInput.IsEnabled="True"
                             behaviors:NumericInput.Maximum="{Binding MaxRestartDelaySeconds}"
                             AutomationProperties.Name="Seconds before auto-restart" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="Increase"
                            AutomationProperties.Name="Increase seconds before auto-restart"
                            Command="{Binding IncreaseRestartDelayCommand}">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE710;" />
                    </Button>
                </StackPanel>
                <TextBlock Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource WarningForegroundBrush}"
                           Visibility="{Binding IsRestartDelayInvalid, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Text="Enter a number from 0 to" />
                    <Run Text="{Binding MaxRestartDelaySeconds, Mode=OneWay}" /><Run Text="." />
                </TextBlock>

                <TextBlock Margin="0,6,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningForegroundBrush}"
                           Text="This copy was not installed with the installer, so it will not be updated."
                           Visibility="{Binding IsNotInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <!-- ===== Toasts (bottom-right, above the content) ===== -->
            <toastViews:ToastHost Grid.Row="1" Panel.ZIndex="10" />

            <!-- ===== Footer ===== -->
            <Border Grid.Row="2"
                    Padding="20,12"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Content="Save"
                            IsDefault="True"
                            Command="{Binding SaveCommand}" />
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource DialogButtonStyle}"
                            Content="Cancel"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
