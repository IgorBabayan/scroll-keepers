<Window x:Class="ScrollKeeper.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:shellVm="clr-namespace:ScrollKeeper.Presentation.ViewModels.Shell"
        xmlns:toastViews="clr-namespace:ScrollKeeper.Presentation.Views.Toasts"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=shellVm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="ScrollKeeper"
        Width="1100"
        Height="720"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource BodyFont}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <!--
        WindowChrome removes the native title bar but keeps native behaviour, like any Windows window:
        drag to move, double-click to maximize, Alt+Space menu, Aero snap and resizing from the edges.
        Settings / Minimize / Maximize / Close are drawn in the title bar (see Themes/WindowChrome.xaml).
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" Executed="OnMinimizeExecuted" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" Executed="OnMaximizeExecuted" />
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}" Executed="OnRestoreExecuted" />
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="OnCloseExecuted" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
    </Window.InputBindings>

    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />  <!-- icon + title -->
                    <ColumnDefinition Width="*" />     <!-- free drag area -->
                    <ColumnDefinition Width="Auto" />  <!-- custom buttons -->
                    <ColumnDefinition Width="Auto" />  <!-- min / max / close -->
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- Application icon (App.ico, embedded as a WPF resource). -->
                    <Image Width="16"
                           Height="16"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/App.ico" />
                    <TextBlock x:Name="TitleText"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Custom buttons placed before the standard caption buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource TitleBarToolButtonStyle}"
                            ToolTip="Settings (Ctrl+,)"
                            Content="&#xE713;"
                            AutomationProperties.Name="Settings"
                            Command="{Binding OpenSettingsCommand}" />
                    <Rectangle Width="1" Margin="4,8" Fill="{DynamicResource WindowBorderBrush}" />
                </StackPanel>

                <!-- Standard caption buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="Minimize"
                            Content="&#xE921;"
                            AutomationProperties.Name="Minimize"
                            Command="{x:Static SystemCommands.MinimizeWindowCommand}" />
                    <!-- Maximize / Restore: glyph and command follow the window state (set in the style so the trigger can change them). -->
                    <Button x:Name="MaximizeButton">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                                <Setter Property="Content" Value="&#xE922;" />
                                <Setter Property="ToolTip" Value="Maximize" />
                                <Setter Property="AutomationProperties.Name" Value="Maximize" />
                                <Setter Property="Command" Value="{x:Static SystemCommands.MaximizeWindowCommand}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Content" Value="&#xE923;" />
                                        <Setter Property="ToolTip" Value="Restore down" />
                                        <Setter Property="AutomationProperties.Name" Value="Restore down" />
                                        <Setter Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButtonStyle}"
                            ToolTip="Close"
                            Content="&#xE8BB;"
                            AutomationProperties.Name="Close"
                            Command="{x:Static SystemCommands.CloseWindowCommand}" />
                </StackPanel>
            </Grid>

            <!-- ===== Content: Installed / Browse ===== -->
            <TabControl Grid.Row="1"
                        Margin="16,6,16,0"
                        Style="{StaticResource UnderlineTabControlStyle}"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                <!-- ===== Installed ===== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding InstalledHeader}" />
                            <Border Margin="8,0,0,0"
                                    Padding="6,0"
                                    MinWidth="18"
                                    CornerRadius="9"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}"
                                    ToolTip="{Binding UpdatesText}"
                                    Visibility="{Binding HasUpdates, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentForegroundBrush}"
                                           Text="{Binding UpdatesCount}" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <DockPanel Grid.Row="0" Margin="0,12,0,8" LastChildFill="False">
                            <TextBox DockPanel.Dock="Left"
                                     Width="300"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Tag="Search installed addons"
                                     AutomationProperties.Name="Search installed addons"
                                     Text="{Binding InstalledSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button DockPanel.Dock="Right"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Rescan the AddOns folder and check ESOUI for updates (F5)"
                                    AutomationProperties.Name="Refresh"
                                    Command="{Binding RefreshCommand}">
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE72C;" />
                            </Button>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Content="Update all"
                                    ToolTip="{Binding UpdatesText}"
                                    Command="{Binding UpdateAllCommand}"
                                    Visibility="{Binding HasUpdates, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding UpdatesText}"
                                       Visibility="{Binding HasUpdates, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </DockPanel>

                        <ListBox Grid.Row="1"
                                 Margin="-12,0"
                                 Style="{StaticResource AddonListBoxStyle}"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                 ItemsSource="{Binding InstalledView}"
                                 ItemTemplate="{StaticResource AddonRowTemplate}"
                                 AutomationProperties.Name="Installed addons">
                            <ListBox.GroupStyle>
                                <StaticResource ResourceKey="AddonGroupStyle" />
                            </ListBox.GroupStyle>
                        </ListBox>

                        <!-- AddOns folder not found -->
                        <StackPanel Grid.Row="1"
                                    MaxWidth="460"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsAddonsFolderMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="20"
                                       Text="Where are your addons?" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="{Binding AddonsFolder, StringFormat='The AddOns folder was not found at {0}. Choose the folder of your Elder Scrolls Online installation in Settings.'}" />
                            <Button Margin="0,16,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Content="Open Settings"
                                    Command="{Binding OpenSettingsCommand}" />
                        </StackPanel>

                        <!-- Nothing installed yet -->
                        <StackPanel Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsInstalledEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="20"
                                       Text="No addons installed yet" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="Find something you like in Browse." />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ===== Browse ===== -->
                <TabItem Header="{Binding BrowseHeader}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <DockPanel Grid.Row="0" Margin="0,12,0,8" LastChildFill="False">
                            <TextBox DockPanel.Dock="Left"
                                     Width="300"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Tag="Search by name, author or category"
                                     AutomationProperties.Name="Search addons"
                                     Text="{Binding BrowseSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <ListBox DockPanel.Dock="Left"
                                     Margin="12,0,0,0"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource PillListBoxStyle}"
                                     ItemsSource="{Binding SortOptions}"
                                     SelectedItem="{Binding SelectedSortOption}"
                                     DisplayMemberPath="DisplayName"
                                     AutomationProperties.Name="Sort by" />
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Reload the addon list from ESOUI (F5)"
                                    AutomationProperties.Name="Refresh"
                                    Command="{Binding RefreshCommand}">
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE72C;" />
                            </Button>
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource WarningForegroundBrush}"
                                       Text="Offline: showing the list from your last visit"
                                       Visibility="{Binding IsCatalogFromCache, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </DockPanel>

                        <ProgressBar Grid.Row="1"
                                     Height="3"
                                     Margin="0,0,0,4"
                                     IsIndeterminate="True"
                                     AutomationProperties.Name="Loading the addon list"
                                     Visibility="{Binding IsLoadingCatalog, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ListBox Grid.Row="2"
                                 Margin="-12,0"
                                 Style="{StaticResource AddonListBoxStyle}"
                                 ItemsSource="{Binding BrowseView}"
                                 ItemTemplate="{StaticResource AddonRowTemplate}"
                                 AutomationProperties.Name="Available addons" />

                        <!-- Catalog could not be loaded -->
                        <StackPanel Grid.Row="2"
                                    MaxWidth="460"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasCatalogError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="20"
                                       Text="ESOUI is out of reach" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="{Binding CatalogError}" />
                            <Button Margin="0,16,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Content="Try again"
                                    Command="{Binding RefreshCommand}" />
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- ===== Toasts (bottom-right, above the content) ===== -->
            <toastViews:ToastHost Grid.Row="1" Panel.ZIndex="10" />
        </Grid>
    </Border>
</Window>
