<Window x:Class="ScrollKeeper.Presentation.Views.Addons.AddonDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:addons="clr-namespace:ScrollKeeper.Presentation.ViewModels.Addons"
        xmlns:documents="clr-namespace:ScrollKeeper.Presentation.Documents"
        xmlns:toastViews="clr-namespace:ScrollKeeper.Presentation.Views.Toasts"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=addons:AddonDetailsViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding Title}"
        Width="920"
        Height="680"
        MinWidth="640"
        MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource BodyFont}"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="OnCloseExecuted" />
    </Window.CommandBindings>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}">
                <TextBlock Margin="12,0,56,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CloseCaptionButtonStyle}"
                        ToolTip="Close (Esc)"
                        Content="&#xE8BB;"
                        AutomationProperties.Name="Close"
                        Command="{x:Static SystemCommands.CloseWindowCommand}" />
            </Grid>

            <!-- ===== Header: icon, name, author, Install / Update ===== -->
            <Grid Grid.Row="1" Margin="24,20,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter Grid.Column="0"
                                  Width="64"
                                  Height="64"
                                  VerticalAlignment="Top"
                                  Content="{Binding Item}"
                                  ContentTemplate="{StaticResource AddonIconTemplate}" />

                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource HeadingFont}"
                               FontSize="24"
                               TextWrapping="Wrap"
                               Text="{Binding Item.Name}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Item.Byline}" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Item.Details}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <ContentPresenter HorizontalAlignment="Right"
                                      Content="{Binding Item}"
                                      ContentTemplate="{StaticResource AddonActionTemplate}" />
                    <Button Margin="0,6,-8,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TextLinkButtonStyle}"
                            Command="{Binding OpenWebPageCommand}"
                            Visibility="{Binding IsOnEsoui, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Open on ESOUI" />
                            <TextBlock Margin="6,1,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="10"
                                       Text="&#xE8A7;" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== Body: page (left) | information (right) ===== -->
            <Grid Grid.Row="2" Margin="24,0,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0"
                                 Height="3"
                                 Margin="0,0,0,8"
                                 IsIndeterminate="True"
                                 AutomationProperties.Name="Loading the addon page"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Grid.Row="1">
                        <TextBlock Margin="0,0,0,8"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ErrorForegroundBrush}"
                                   Text="{Binding Error}"
                                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Margin="0,0,0,8"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningForegroundBrush}"
                                   Text="A new version of this addon is waiting for approval by the ESOUI staff."
                                   Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <TabControl Grid.Row="2" Style="{StaticResource PillTabControlStyle}">
                        <TabItem Header="Description">
                            <FlowDocumentScrollViewer Margin="0,12,0,0"
                                                      Padding="0"
                                                      IsToolBarVisible="False"
                                                      IsSelectionEnabled="True"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      SelectionBrush="{DynamicResource AccentBrush}"
                                                      documents:BbCode.Text="{Binding Description}" />
                        </TabItem>
                        <TabItem Header="Change log"
                                 Visibility="{Binding HasChangeLog, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <FlowDocumentScrollViewer Margin="0,12,0,0"
                                                      Padding="0"
                                                      IsToolBarVisible="False"
                                                      IsSelectionEnabled="True"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      SelectionBrush="{DynamicResource AccentBrush}"
                                                      documents:BbCode.Text="{Binding ChangeLog}" />
                        </TabItem>
                        <TabItem Header="Pictures"
                                 Visibility="{Binding HasScreenshots, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer Margin="0,12,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Screenshots}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type addons:ScreenshotViewModel}">
                                            <Button Width="180"
                                                    Height="120"
                                                    Margin="0,0,10,10"
                                                    Padding="0"
                                                    Style="{StaticResource ListRowButtonStyle}"
                                                    ToolTip="Open the full picture"
                                                    Command="{Binding DataContext.OpenScreenshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Border CornerRadius="6"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource WindowBorderBrush}"
                                                        Background="{DynamicResource CardBackgroundBrush}">
                                                    <Border CornerRadius="6">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border.Background>
                                                    </Border>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Information -->
                <Border Grid.Column="1"
                        Margin="20,0,0,0"
                        Padding="16,14"
                        VerticalAlignment="Top"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource WindowBorderBrush}"
                        Background="{DynamicResource CardBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Information" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Facts}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                   Text="{Binding Key}" />
                                        <TextBlock Margin="0,1,0,0"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Value}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Toasts (bottom-right, above the content) ===== -->
            <toastViews:ToastHost Grid.Row="2" Panel.ZIndex="10" />
        </Grid>
    </Border>
</Window>
