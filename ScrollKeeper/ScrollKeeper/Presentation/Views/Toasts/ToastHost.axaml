<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ScrollKeeper.Presentation.Controls"
             xmlns:toasts="using:ScrollKeeper.Presentation.Services.Toasts"
             x:Class="ScrollKeeper.Presentation.Views.Toasts.ToastHost"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Margin="16">

    <!--
        Bottom-right stack of toasts. Placed in every window that may be in front (main window, Settings, addon page);
        only the frontmost host shows them, see ToastHost.axaml.cs.
    -->
    <UserControl.Styles>
        <!-- Slide + fade in when the toast appears. -->
        <Style Selector="Panel.toast">
            <Style.Animations>
                <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="12" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <ItemsControl x:Name="ToastList" ItemsSource="{Binding Toasts}" Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="toasts:Toast">
                <Panel Classes="toast" Width="340" Margin="0,8,0,0">
                    <Border CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Background="{DynamicResource TitleBarBackgroundBrush}"
                            BoxShadow="0 2 16 0 #59000000"
                            Padding="14,12,8,12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- severity icon | text | close -->
                            <controls:SeverityIcon Grid.Column="0"
                                                   Margin="0,1,12,0"
                                                   VerticalAlignment="Top"
                                                   IconSize="20"
                                                   StrokeThickness="1.8"
                                                   Severity="{Binding Severity}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Message}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource WindowForegroundBrush}" />
                                <TextBlock Margin="0,2,0,0"
                                           Text="{Binding Details}"
                                           Theme="{StaticResource SecondaryText}"
                                           IsVisible="{Binding HasDetails}" />
                                <ProgressBar Margin="0,8,0,0"
                                             Height="4"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             IsVisible="{Binding HasProgress}" />
                                <Button Margin="-8,6,0,0"
                                        HorizontalAlignment="Left"
                                        Theme="{StaticResource TextLinkButton}"
                                        Content="{Binding ActionText}"
                                        Command="{Binding ActionCommand}"
                                        IsVisible="{Binding HasAction}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    ToolTip.Tip="Close"
                                    Theme="{StaticResource SubtleIconButton}"
                                    Command="{Binding $parent[ItemsControl].DataContext.DismissCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding IsClosable}">
                                <controls:Icon IconSize="11" Data="{StaticResource CloseGeometry}" />
                            </Button>
                        </Grid>
                    </Border>
                </Panel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
