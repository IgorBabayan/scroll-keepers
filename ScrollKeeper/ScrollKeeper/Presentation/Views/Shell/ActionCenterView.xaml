<UserControl x:Class="ScrollKeeper.Presentation.Views.Shell.ActionCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shellVm="clr-namespace:ScrollKeeper.Presentation.ViewModels.Shell"
             xmlns:notifications="clr-namespace:ScrollKeeper.Presentation.Services.Notifications"
             xmlns:toasts="clr-namespace:ScrollKeeper.Presentation.Services.Toasts"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=shellVm:ActionCenterViewModel, IsDesignTimeCreatable=False}"
             FontFamily="{StaticResource BodyFont}">

    <!--
        Content of the action center flyout (Popup in MainWindow.xaml). The outer margin leaves room for the shadow.
    -->
    <Grid Width="360" Margin="12,0,12,12">
        <!-- Shadow is drawn by a separate element so the content text stays crisp. -->
        <Border CornerRadius="8" Background="{DynamicResource WindowBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.35" Color="Black" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                Background="{DynamicResource TitleBarBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="16,10,8,10" LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource TextLinkButtonStyle}"
                            Content="Clear all"
                            AutomationProperties.Name="Clear all notifications"
                            Command="{Binding ClearAllCommand}"
                            Visibility="{Binding Center.IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="16"
                               Foreground="{DynamicResource WindowForegroundBrush}"
                               Text="Notifications" />
                </DockPanel>

                <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource WindowBorderBrush}" />

                <!-- Nothing to show -->
                <StackPanel Grid.Row="2"
                            Margin="16,32"
                            HorizontalAlignment="Center"
                            Visibility="{Binding Center.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Center"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="28"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Text="&#xE91C;" />
                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SecondaryTextStyle}"
                               Text="You're all caught up" />
                </StackPanel>

                <!-- Notifications, newest first -->
                <ScrollViewer Grid.Row="2"
                              MaxHeight="440"
                              Padding="6"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Center.IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Center.Notifications}"
                                  Focusable="False"
                                  AutomationProperties.Name="Notifications">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type notifications:Notification}">
                                <Grid>
                                    <!-- The whole row runs the notification's action. -->
                                    <Button Style="{StaticResource ListRowButtonStyle}"
                                            Padding="10,10,36,10"
                                            Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Title}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /> <!-- severity icon -->
                                                <ColumnDefinition Width="*" />    <!-- text -->
                                            </Grid.ColumnDefinitions>

                                            <TextBlock x:Name="SeverityIcon"
                                                       Grid.Column="0"
                                                       Margin="0,1,12,0"
                                                       VerticalAlignment="Top"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="16"
                                                       Text="&#xE946;"
                                                       Foreground="{DynamicResource AccentBrush}" />

                                            <StackPanel Grid.Column="1">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Margin="8,1,0,0"
                                                               VerticalAlignment="Top"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                               Text="{Binding TimeText}" />
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource WindowForegroundBrush}" />
                                                </DockPanel>
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding Details}"
                                                           TextWrapping="Wrap"
                                                           Style="{StaticResource SecondaryTextStyle}"
                                                           Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Margin="0,6,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Text="{Binding ActionText}"
                                                           Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <!-- Unread dot, in the row's left padding next to the icon. -->
                                    <Ellipse Width="5"
                                             Height="5"
                                             Margin="2,17,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             IsHitTestVisible="False"
                                             Fill="{DynamicResource AccentBrush}"
                                             Visibility="{Binding IsUnread, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <Button Margin="0,6,6,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            ToolTip="Remove"
                                            AutomationProperties.Name="Remove notification"
                                            Style="{StaticResource SubtleIconButtonStyle}"
                                            Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="10" Text="&#xE8BB;" />
                                    </Button>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static toasts:ToastSeverity.Success}">
                                        <Setter TargetName="SeverityIcon" Property="Text" Value="&#xE930;" />
                                        <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static toasts:ToastSeverity.Warning}">
                                        <Setter TargetName="SeverityIcon" Property="Text" Value="&#xE7BA;" />
                                        <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static toasts:ToastSeverity.Error}">
                                        <Setter TargetName="SeverityIcon" Property="Text" Value="&#xEA39;" />
                                        <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
