<!--
    Light palette of Claude for desktop: ivory paper surfaces, near-black text and the clay accent.
    Every palette must define the same set of keys (see ClaudeDark.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TitleBarBackgroundBrush"         Color="#F0EEE6" />
    <SolidColorBrush x:Key="TitleBarInactiveForegroundBrush" Color="#9C9A92" />
    <SolidColorBrush x:Key="WindowBackgroundBrush"           Color="#FAF9F5" />
    <SolidColorBrush x:Key="WindowBorderBrush"               Color="#E0DDD3" />
    <SolidColorBrush x:Key="WindowForegroundBrush"           Color="#141413" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush"        Color="#6B6A64" />
    <SolidColorBrush x:Key="CaptionButtonHoverBrush"         Color="#14000000" />
    <SolidColorBrush x:Key="CaptionButtonPressedBrush"       Color="#0A000000" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush"           Color="#C42B1C" />
    <SolidColorBrush x:Key="CloseButtonPressedBrush"         Color="#A32317" />
    <SolidColorBrush x:Key="ControlBackgroundBrush"          Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush"              Color="#D9D6CC" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush"         Color="#B8B5A9" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush"           Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush"      Color="#F0EEE6" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush"    Color="#E8E5DB" />
    <SolidColorBrush x:Key="AccentBrush"                     Color="#C96442" />
    <SolidColorBrush x:Key="AccentHoverBrush"                Color="#B5583A" />
    <SolidColorBrush x:Key="AccentPressedBrush"              Color="#A44E33" />
    <SolidColorBrush x:Key="AccentForegroundBrush"           Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSubtleBackgroundBrush"     Color="#F5E6DE" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush"        Color="#EAE6DC" />
    <SolidColorBrush x:Key="ListItemHoverBackgroundBrush"    Color="#F0EEE6" />
    <SolidColorBrush x:Key="CardBackgroundBrush"             Color="#FFFFFF" />
    <SolidColorBrush x:Key="WarningForegroundBrush"          Color="#A86A00" />
    <SolidColorBrush x:Key="ErrorForegroundBrush"            Color="#C23B3B" />
    <SolidColorBrush x:Key="SuccessForegroundBrush"          Color="#2E7D32" />

</ResourceDictionary>
