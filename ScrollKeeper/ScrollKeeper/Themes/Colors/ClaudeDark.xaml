<!--
    Dark palette of Claude for desktop: warm charcoal surfaces, ivory text and the clay accent.
    Every palette must define the same set of keys (see ClaudeLight.xaml).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TitleBarBackgroundBrush"         Color="#1F1E1D" />
    <SolidColorBrush x:Key="TitleBarInactiveForegroundBrush" Color="#85837C" />
    <SolidColorBrush x:Key="WindowBackgroundBrush"           Color="#262624" />
    <SolidColorBrush x:Key="WindowBorderBrush"               Color="#3A3936" />
    <SolidColorBrush x:Key="WindowForegroundBrush"           Color="#FAF9F5" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush"        Color="#A6A39A" />
    <SolidColorBrush x:Key="CaptionButtonHoverBrush"         Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="CaptionButtonPressedBrush"       Color="#12FFFFFF" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush"           Color="#C42B1C" />
    <SolidColorBrush x:Key="CloseButtonPressedBrush"         Color="#A32317" />
    <SolidColorBrush x:Key="ControlBackgroundBrush"          Color="#30302E" />
    <SolidColorBrush x:Key="ControlBorderBrush"              Color="#45443F" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush"         Color="#6B6962" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush"           Color="#30302E" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush"      Color="#3A3935" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush"    Color="#2A2927" />
    <SolidColorBrush x:Key="AccentBrush"                     Color="#D97757" />
    <SolidColorBrush x:Key="AccentHoverBrush"                Color="#E08A6D" />
    <SolidColorBrush x:Key="AccentPressedBrush"              Color="#C6613F" />
    <SolidColorBrush x:Key="AccentForegroundBrush"           Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSubtleBackgroundBrush"     Color="#3A2C25" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush"        Color="#3D3833" />
    <SolidColorBrush x:Key="ListItemHoverBackgroundBrush"    Color="#30302E" />
    <SolidColorBrush x:Key="CardBackgroundBrush"             Color="#2B2A28" />
    <SolidColorBrush x:Key="WarningForegroundBrush"          Color="#E5B95C" />
    <SolidColorBrush x:Key="ErrorForegroundBrush"            Color="#F1707B" />
    <SolidColorBrush x:Key="SuccessForegroundBrush"          Color="#7BC17E" />

</ResourceDictionary>
